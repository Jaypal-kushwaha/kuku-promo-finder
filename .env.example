# Copy this file to ".env" (same folder) and paste your keys after the "=".
#   Linux / Mac:  cp .env.example .env
#   Windows:      copy .env.example .env
# You need at least ONE key. Leave the others empty: empty keys are skipped.
# Keys are tried in this order (set in config.yaml); when one runs out, the next takes over.

# Claude (paid)                    https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=

# Google Gemini (free)             https://aistudio.google.com/apikey
# One key per Google account; more keys = more free requests per day.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Free backups, used only after the keys above run out
GROQ_API_KEY=                      # https://console.groq.com/keys
MISTRAL_API_KEY=                   # https://console.mistral.ai
OPENROUTER_API_KEY=                # https://openrouter.ai/keys
